{"id": "31156d98-84f6-5c20-9b70-e5ddb852a063", "name": "", "type": "TextSummary", "created_at": 1788471597315, "updated_at": 1788471597315, "ontology_valid": false, "ontology_uri": null, "version": 1, "topological_rank": 3, "valid_to": null, "metadata": {"index_fields": ["text"]}, "belongs_to_set": null, "source_pipeline": "cognify_pipeline", "source_task": "extract_graph_and_summarize", "source_node_set": null, "source_user": "default_user@example.com", "source_content_hash": "21c66c34193b927b6a66cc445be55458", "feedback_weight": 0.5, "importance_weight": 0.5, "text": "This chunk is about: \n- Topics: Recall queries \n- Companies: Anthropic, Cognee \n- People: Alice \n- Products: litellm, Ladybug \n\nFacts: \n- A recall query like 'who works at Anthropic' returns the person Alice. \n- A recall query like 'what does Cognee depend on' returns the products litellm and Ladybug.", "source_chunk_id": "630e0143-9724-5ed2-a5ae-00ab10e4e1d0", "summarized_in": null, "global_context_bucket_id": null}
