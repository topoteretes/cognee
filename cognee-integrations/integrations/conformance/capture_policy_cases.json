  "redact_cases": [
    {
      "note": "private key block",
      "env": {},
      "input": "before\n-----BEGIN RSA PRIVATE KEY-----\nMIIEpAIBAAKCAQEA\nabc\n-----END RSA PRIVATE KEY-----\nafter",
      "expected": "before\n[redacted:private-key]\nafter"
    },
    {
      "note": "unterminated private key runs to the end",
      "env": {},
      "input": "-----BEGIN PRIVATE KEY-----\nMIIEvQIBADANBg",
      "expected": "[redacted:private-key]"
    },
    {
      "note": "unterminated private key keeps a final newline",
      "env": {},
      "input": "-----BEGIN PRIVATE KEY-----\nMIIEvQIBADANBg\n",
      "expected": "[redacted:private-key]\n"
    },
    {
      "note": "postgres url",
      "env": {},
      "input": "db: postgresql://user:pw@host:5432/app?ssl=1 done",
      "expected": "db: [redacted:connection] done"
    },
    {
      "note": "mongodb+srv url",
      "env": {},
      "input": "MONGO=mongodb+srv://u:p@cluster0.example.net/db",
      "expected": "MONGO=[redacted:connection]"
    },
    {
      "note": "redis url in quotes",
      "env": {},
      "input": "url=\"redis://:pw@localhost:6379/0\"",
      "expected": "url=\"[redacted:connection]\""
    },
    {
      "note": "amqps url",
      "env": {},
      "input": "AMQPS://guest:guest@rabbit/",
      "expected": "[redacted:connection]"
    },
    {
      "note": "bearer token",
