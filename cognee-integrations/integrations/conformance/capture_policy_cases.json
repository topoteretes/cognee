    },
    {
      "note": "shell: git status is allowed",
      "env": {},
      "tool": "Bash",
      "params": {
        "command": "git status"
      },
      "expected": true
    },
    {
      "note": "shell: cat README.md is allowed",
      "env": {},
      "tool": "Bash",
      "params": {
        "command": "cat README.md"
      },
      "expected": true
    },
    {
      "note": "shell: echo is allowed",
