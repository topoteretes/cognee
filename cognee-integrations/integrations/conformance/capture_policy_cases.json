      "expected": "Authorization: [redacted:authorization]"
    },
    {
      "note": "basic auth",
      "env": {},
      "input": "curl -H 'Authorization: Basic dXNlcjpwYXNz' x",
      "expected": "curl -H 'Authorization: [redacted:authorization]' x"
    },
    {
      "note": "credential assignment",
      "env": {},
      "input": "password=supersecret",
      "expected": "[redacted:credential]"
    },
    {
      "note": "credential json pair",
      "env": {},
      "input": "{\"api_key\": \"hidden-value\", \"name\": \"ok\"}",
      "expected": "{[redacted:credential], \"name\": \"ok\"}"
    },
    {
      "note": "credential with prefix",
      "env": {},
      "input": "export GITHUB_TOKEN=abc123 && run",
      "expected": "export [redacted:credential] && run"
    },
    {
      "note": "credential colon single quotes",
      "env": {},
      "input": "client_secret: 'x y z'",
      "expected": "[redacted:credential]"
    },
    {
      "note": "credential stops at comma",
      "env": {},
      "input": "token=abc,next=1",
      "expected": "[redacted:credential],next=1"
    },
    {
      "note": "x-api-key header",
      "env": {},
      "input": "x-api-key: k-12345",
      "expected": "[redacted:credential]"
    },
    {
      "note": "openai key",
      "env": {},
      "input": "key sk-proj-abcdefghijklmnopqrstuvwx end",
      "expected": "key [redacted:vendor-key] end"
    },
    {
      "note": "anthropic key",
      "env": {},
      "input": "sk-ant-abcdefghijklmnop1234",
      "expected": "[redacted:vendor-key]"
    },
    {
      "note": "github token",
      "env": {},
      "input": "ghp_012345678901234567890123456789",
      "expected": "[redacted:vendor-key]"
    },
    {
      "note": "github pat",
      "env": {},
      "input": "github_pat_11ABCDEFG0123456789_abcdef",
      "expected": "[redacted:vendor-key]"
    },
    {
      "note": "slack token",
      "env": {},
