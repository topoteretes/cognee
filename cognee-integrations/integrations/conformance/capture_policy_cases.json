      },
      "expected": true
    },
    {
      "note": "shell: a glob is not expanded",
      "env": {},
      "tool": "Bash",
      "params": {
        "command": "cat ~/.aws/cred*"
      },
      "expected": true
    },
    {
      "note": "shell: a non-string command is ignored",
      "env": {},
      "tool": "Bash",
      "params": {
        "command": [
          "cat",
          ".env"
        ]
      },
      "expected": true
    },
    {
      "note": "a path under a non-path, non-command key is not checked",
      "env": {},
      "tool": "Write",
      "params": {
        "file_path": "notes.md",
        "content": "run cat .env to see it"
      },
      "expected": true
    }
