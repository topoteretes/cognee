################################################################################
#  cognee-connectors environment template
#
#  Copy this file to `.env` next to the code that runs a connector and fill in
#  the provider you use. Every variable name is exactly what the same provider
#  reads in cognee (`cognee/modules/integrations/<provider>/<provider>_settings.py`):
#  the connector packages subclass the same settings with the same `env_prefix`,
#  so a `.env` that worked with cognee's built-in integrations works unchanged
#  here. The Slack, GitHub, Linear, Google Drive, Google Calendar and Notion
#  blocks below are copied from cognee's `.env.template`; the Gmail and keyring
#  blocks are written from the settings code (`gmail_settings.py`, `crypto.py`),
#  which cognee's template does not spell out. A connector's README documents
#  its block too.
#
#  The LLM, embedding and database settings a cognee server or SDK script needs
#  are cognee's own: see https://github.com/topoteretes/cognee/blob/dev/.env.template.
#
#  Apollo, Asana, Obsidian and OneNote take their credentials as arguments of
#  their `*_source(...)` factories and have no settings block; see the package
#  READMEs under connectors/.
################################################################################

#  Integrations
#  Third-party OAuth integrations (cognee/modules/integrations/). Each
#  provider registers itself at startup; one whose secrets are left unset
#  responds 503 "not configured" to connect attempts and rejects inbound
#  webhooks, so unset deployments effectively cannot use it. See
#  cognee/api/v1/integrations/routers/get_integrations_router.py for the
#  generic install-flow endpoints every provider shares.
################################################################################

# -- Slack ---------------------------------------------------------------------
# Create a Slack app at https://api.slack.com/apps to get these values.
# CLIENT_ID/CLIENT_SECRET: OAuth & Permissions > your app's Basic Information.
# SIGNING_SECRET: Basic Information > App Credentials — verifies inbound
# requests (slash commands, events, interactive callbacks) via X-Slack-Signature.
# REDIRECT_URI: must match a URL registered under OAuth & Permissions >
# Redirect URLs exactly, and point at this server's
# /api/v1/integrations/slack/callback.
# FRONTEND_BASE_URL: where the browser is redirected back to after
# connect/cancel/error (appends ?slack=<outcome> to /integrations).
#SLACK_CLIENT_ID=""
#SLACK_CLIENT_SECRET=""
#SLACK_SIGNING_SECRET=""
#SLACK_REDIRECT_URI="http://localhost:8000/api/v1/integrations/slack/callback"
#SLACK_FRONTEND_BASE_URL="http://localhost:3000"

# -- GitHub --------------------------------------------------------------------
# Create a GitHub App at https://github.com/settings/apps to get these values.
# Required app configuration: "Request user authorization (OAuth) during
# installation" enabled; Callback URL pointing at this server's
# /api/v1/integrations/github/callback; Webhook URL pointing at
# /api/v1/integrations/github/events; repository permission
# "Contents: Read-only"; subscribed events: Push, Installation repositories.
# APP_ID: the numeric id from the app settings page.
# APP_SLUG: the app's URL slug (github.com/apps/<slug>).
# APP_PRIVATE_KEY: the app's PEM private key ("\n" escapes accepted).
# WEBHOOK_SECRET: verifies inbound deliveries via X-Hub-Signature-256, and
# signs the OAuth state parameter.
#GITHUB_APP_ID=""
#GITHUB_APP_SLUG=""
#GITHUB_APP_PRIVATE_KEY=""
#GITHUB_CLIENT_ID=""
#GITHUB_CLIENT_SECRET=""
#GITHUB_WEBHOOK_SECRET=""
#GITHUB_FRONTEND_BASE_URL="http://localhost:3000"

# -- Linear --------------------------------------------------------------------
# Create a Linear OAuth app at https://linear.app/settings/api/applications.
# This is an *agent* app: the authorize URL uses actor=app, which installs an
# app user into the workspace that members can @mention or delegate issues to
# — the agent answers from cognee memory. On the app, enable "Agent session
# events" (the agent) and "Issues", "Comments" and "Projects" (keep memory
# current), and point its webhook URL at this server's
# /api/v1/integrations/linear/events.
# Connecting ingests every team the app was granted, with full history. Narrow
# it with PUT /api/v1/integrations/linear/resources (GET lists the teams).
# CLIENT_ID/CLIENT_SECRET: from the app's settings page.
# WEBHOOK_SECRET: the app's webhook signing secret — verifies inbound
# deliveries via the Linear-Signature header, and signs the OAuth state
# parameter.
# REDIRECT_URI: must match a callback URL registered on the app exactly, and
# point at this server's /api/v1/integrations/linear/callback.
# FRONTEND_BASE_URL: where the browser is redirected back to after
# connect/cancel/error (appends ?linear=<outcome> to /integrations).
#LINEAR_CLIENT_ID=""
#LINEAR_CLIENT_SECRET=""
#LINEAR_WEBHOOK_SECRET=""
#LINEAR_REDIRECT_URI="http://localhost:8000/api/v1/integrations/linear/callback"
#LINEAR_FRONTEND_BASE_URL="http://localhost:3000"

# Google Drive: one OAuth client in a Google Cloud project, consented per
# account. Personal and Workspace accounts use the same client and the same
# flow; they are told apart by the hosted-domain claim after connecting.
# CLIENT_ID / CLIENT_SECRET: from the OAuth 2.0 Client ID (type: Web
# application) in that project's Credentials page.
# STATE_SECRET: any long random string. It signs the OAuth state parameter,
# which is the only thing binding a callback to the user who started it.
# REDIRECT_URI: must be listed verbatim as an authorized redirect URI on the
# client, and point at this server's callback.
# FRONTEND_BASE_URL: where the browser lands after connect/cancel/error
# (appends ?google_drive=<outcome> to /integrations).
# Note: drive.readonly is a restricted scope, so a public launch needs
# Google's OAuth verification first. Test users work without it.
#GOOGLE_DRIVE_CLIENT_ID=""
#GOOGLE_DRIVE_CLIENT_SECRET=""
#GOOGLE_DRIVE_STATE_SECRET=""
#GOOGLE_DRIVE_REDIRECT_URI="http://localhost:8000/api/v1/integrations/google_drive/callback"
#GOOGLE_DRIVE_FRONTEND_BASE_URL="http://localhost:3000"

# Google Calendar: its own OAuth client and consent screen, same variables as
# Drive. Calendars are opt-in: nothing syncs until the user selects calendars in
# the integrations page. The browser comes back with ?google_calendar=<outcome>.
# The SDK connector reads the same GOOGLE_CALENDAR_* prefix for local use
# (GOOGLE_CALENDAR_IDS, GOOGLE_CALENDAR_REFRESH_TOKEN and friends); hosted syncs
# never use those.
# Note: calendar.readonly is a sensitive scope, so a public launch needs
# Google's OAuth verification first. Test users work without it.
#GOOGLE_CALENDAR_CLIENT_ID=""
#GOOGLE_CALENDAR_CLIENT_SECRET=""
#GOOGLE_CALENDAR_STATE_SECRET=""
#GOOGLE_CALENDAR_REDIRECT_URI="http://localhost:8000/api/v1/integrations/google_calendar/callback"
#GOOGLE_CALENDAR_FRONTEND_BASE_URL="http://localhost:3000"

# Gmail: its own OAuth client and consent screen, same variables as Drive and
# Calendar (cognee/modules/integrations/gmail/gmail_settings.py reads the
# GOOGLE_GMAIL_ prefix). The browser comes back with ?gmail=<outcome>.
# Note: gmail.readonly is a restricted scope, so a public launch needs
# Google's OAuth verification first. Test users work without it.
#GOOGLE_GMAIL_CLIENT_ID=""
#GOOGLE_GMAIL_CLIENT_SECRET=""
#GOOGLE_GMAIL_STATE_SECRET=""
#GOOGLE_GMAIL_REDIRECT_URI="http://localhost:8000/api/v1/integrations/gmail/callback"
#GOOGLE_GMAIL_FRONTEND_BASE_URL="http://localhost:3000"

# Notion: one public integration in a Notion workspace, authorized per workspace
# (a second workspace is a second connection). Nothing syncs until the user
# picks pages or databases in the integrations page. The browser comes back with
# ?notion=<outcome>.
# CLIENT_ID / CLIENT_SECRET: from the public integration's OAuth settings at
# notion.so/profile/integrations. Notion's token endpoint takes them as HTTP Basic.
# STATE_SECRET: any long random string. It signs the OAuth state parameter.
# REDIRECT_URI: must be listed verbatim on the integration, and point at this
# server's callback.
#NOTION_CLIENT_ID=""
#NOTION_CLIENT_SECRET=""
#NOTION_STATE_SECRET=""
#NOTION_REDIRECT_URI="http://localhost:8000/api/v1/integrations/notion/callback"
#NOTION_FRONTEND_BASE_URL="http://localhost:3000"

# -- Credential keyring --------------------------------------------------------
# Stored OAuth credentials are encrypted at rest with AES-256-GCM under a
# keyring (cognee/modules/integrations/crypto.py): a set of 32-byte keys
# (base64) each addressed by a short key id. New rows are written under the
# active key id; every row stores the id it was written with, so rotation is
# adding a key to the ring and pointing the active id at it — old rows keep
# decrypting under their original id. A cognee server that hosts any connector
# needs this; the SDK path (`remember(<p>_source(...))`) stores nothing.
# KEYS: JSON object {"<key_id>": "<base64 32-byte key>"} holding every
# currently-decryptable key. Preferred.
# ACTIVE_KEY_ID: the key id new rows are written under (must exist in the
# ring). Defaults to "1".
# KEY: legacy single-key fallback used only when KEYS is unset; loaded into
# the ring under id "1".
# Generate a key with: python -c "import os, base64; print(base64.b64encode(os.urandom(32)).decode())"
#INTEGRATION_CREDENTIALS_KEYS='{"1": "<base64 32-byte key>"}'
#INTEGRATION_CREDENTIALS_ACTIVE_KEY_ID="1"
#INTEGRATION_CREDENTIALS_KEY=""
